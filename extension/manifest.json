{
  "manifest_version": 3,
  "name": "QR Code 即時解讀",
  "version": "1.0.0",
  "description": "貼上 / 上傳 / 掃描 QR Code，即時解讀網址、文字、簡訊、電話、Email、WiFi",
  "action": {
    "default_popup": "popup.html",
    "default_title": "QR Code 即時解讀"
  },
  "permissions": [
    "clipboardRead"
  ],
  "host_permissions": [],
  "icons": {
    "128": "favicon.png"
  }
}